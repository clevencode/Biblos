# URL público do APK no R2 (banner web Android + HEAD update no APK nativo).
# Ex.: https://pub-xxxx.r2.dev/Biblos.apk  — mesmo object key em cada release.
VITE_APK_DOWNLOAD_URL=https://pub-xxxx.r2.dev/Biblos.apk
# Allowlist nativo+JS (CSV de sufixos de host). Default: .r2.dev
VITE_APK_ALLOWED_HOST_SUFFIXES=.r2.dev
# Upload local: npm run mobile:apk:publish  (ou mobile:apk:release:publish)
# Prepare local: npm run mobile:release:prepare  (dirty check + bump versionCode + sync)
# CI: tag v* → .github/workflows/publish-apk.yml (secrets no GitHub Actions)
# Manual: dashboard R2 → upload por cima do mesmo key, Cache-Control: no-cache
# CORS Capacitor (HEAD/ETag): colar scripts/r2-cors-apk.json na política CORS do bucket
R2_BUCKET=biblos-releases
R2_OBJECT_KEY=Biblos.apk
CLOUDFLARE_ACCOUNT_ID=
# Token com R2 Edit — ou: npx wrangler login
CLOUDFLARE_API_TOKEN=

# ——— Firebase Auth (client Vite + Android google-services.json) ———
# Console Firebase → Project settings → Your apps → Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# OAuth Web client ID (Google Sign-In natif Capacitor) — client Web Firebase
VITE_FIREBASE_WEB_CLIENT_ID=
# App Check (reCAPTCHA v3) — Console → App Check → registar app Web + site key
# Só depois activar enforcement. Em DEV: debug token automático se a key existir.
VITE_FIREBASE_APPCHECK_SITE_KEY=
# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
# E-mail admin CMS (#admin) — UX (link Profil). Writes exigem claim admin no token.
# Sem valor: ninguém vê o link admin. Nunca commitar e-mail real aqui.
VITE_CLEVENCODE_ADMIN_EMAIL=admin@example.com
#
# Auth local-first (même projet Firebase) :
# 1) Console → Authentication → Sign-in method :
#    - Anonymous (obligatoire pour guest online)
#    - Google + Email/Password (upgrade Profil)
# 2) Firestore : reading_plans + users/{uid}/highlights|notes|planProgress
#    (jamais les textes bibliques S21/HT98 — restent IndexedDB local)
# 3) Claim editor: npm run firebase:set-editor-claim -- --email …
# 4) Deploy rules : npm run firebase:deploy-rules
#
# Android APK (WebView → provedor remoto auth + planos):
# 1) Firebase Console → Add app → Android → package app.biblos.mobile
# 2) google-services.json (obrigatório) — preferir CLI:
#      npx firebase-tools@latest login
#      npm run firebase:google-services
#    (cria app Android app.biblos.mobile se faltar, regista SHA debug/release, escreve o JSON)
#    Manual: Console → Add Android app → download → android/app/google-services.json
#    Sem este ficheiro: default_web_client_id ausente → Google Sign-In falha (jeton manquant).
# 3) SHA-1/256: o script firebase:google-services regista-os; senão signingReport / keytool
#    Debug típico (máquina local): keytool -list -v -keystore %USERPROFILE%\.android\debug.keystore
# 4) android/variables.gradle: rgcfaIncludeGoogle=true (Google Sign-In no APK)
# 5) capacitor.config.ts: FirebaseAuthentication.skipNativeAuth=true
#    (plugin só idToken; sessão Firebase só no JS SDK via signInWithCredential)
# 6) npm run mobile:sync  (= ensure:mobile-remote + build + cap sync)
# Bypass urgência sem google-services: ALLOW_MOBILE_WITHOUT_GOOGLE_SERVICES=1

NOTION_TOKEN=
# Data source IDs (collection://…) — só em secrets locais / Vercel (nunca IDs reais aqui)
NOTION_BIBLECARDS_DB=
NOTION_PLAN_DB=
# Notifications in-app (mises à jour)
NOTION_NOTIFICATIONS_DB=
#
# Architecture (mobile-first):
# - Notion = CMS lecture seule via Vercel : /api/catalog, /api/notifications, /api/description-sync
# - Aucune donnée utilisateur vers Notion (profil, activité, flashcards, aide, notes de plan)
# - Firebase Auth + Firestore : profil, activité, messages d’aide, état SRS/plans
# - Notes du plan = localStorage uniquement
#
# Planos: Published (checkbox) obligatoire pour apparaître dans l’app (catalogue public)
# Index: /api/catalog?mode=index|full
#
# Deploy Vercel: NOTION_TOKEN + IDs ci-dessus ; partager chaque DB avec l’intégration Notion
#
# Texte biblique : Segond 21 locale (data/bible/s21) — node scripts/convert-s21.mjs
# Mobile (npm run build:mobile) : assets copiés → public/bible/s21 (~6 Mo dans l’APK)
#   Lecture + recherche sans /api/youversion ; sync CMS reste via PROD_ORIGIN/api/*
# Web preview : /api/youversion (Vercel ou vite.notion.ts en dev)
# Description sync: /api/description-sync?url=… (propriedade Notion Description du PLAN)
