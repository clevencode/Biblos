# URL do APK para o banner « Télécharger l’app (APK) » no Chrome Android (web).
# Coloque o ficheiro em public/downloads/biblos.apk ou use um CDN.
VITE_APK_DOWNLOAD_URL=/downloads/biblos.apk

# ——— Firebase Auth (client Vite + Android google-services.json) ———
# Console Firebase → Project settings → Your apps → Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# OAuth Web client ID (Google Sign-In natif Capacitor) — client Web Firebase
VITE_FIREBASE_WEB_CLIENT_ID=
# E-mail admin CMS (#admin) — único usuário que vê o link no Profil + writes editorial
# Défaut code: clevypetit@gmail.com si vide
VITE_CLEVENCODE_ADMIN_EMAIL=clevypetit@gmail.com
#
# Auth local-first (même projet Firebase) :
# 1) Console → Authentication → Sign-in method :
#    - Anonymous (obligatoire pour guest online)
#    - Google + Email/Password (upgrade Profil)
# 2) Firestore : reading_plans + users/{uid}/highlights|notes|planProgress
#    (jamais les textes bibliques S21/HT98 — restent IndexedDB local)
# 3) Deploy rules : firestore.rules
#
# Android APK:
# 1) Firebase Console → Add app → Android → package app.biblos.mobile
# 2) Télécharger google-services.json → android/app/google-services.json
# 3) SHA-1/256 du keystore debug (./gradlew signingReport) dans Firebase
# 4) npm run mobile:sync

NOTION_TOKEN=
# Data source IDs (collection://…) — BIBLECARDS + PLAN DE LECTURE BIBLIQUE
NOTION_BIBLECARDS_DB=903652b8-bfa0-4899-90fd-590837d6eb2f
NOTION_PLAN_DB=3d103af9-2e96-80c4-bcdd-000bd60ac72f
# Notifications in-app (mises à jour) — DB sous la page Biblos
NOTION_NOTIFICATIONS_DB=5d217d65-b106-46f6-8ddc-c86ff7197e30
#
# Architecture (mobile-first):
# - Notion = CMS lecture seule via Vercel : /api/catalog, /api/notifications, /api/description-sync
# - Aucune donnée utilisateur vers Notion (profil, activité, flashcards, aide, notes de plan)
# - Firebase Auth + Firestore : profil, activité, messages d’aide, état SRS/plans
# - Notes du plan = localStorage uniquement
#
# Planos: Published (checkbox) obligatoire pour apparaître dans l’app (catalogue public)
# Index: /api/catalog?mode=index|full
#
# Deploy Vercel: NOTION_TOKEN + IDs ci-dessus ; partager chaque DB avec l’intégration Notion
#
# Texte biblique : Segond 21 locale (data/bible/s21) — node scripts/convert-s21.mjs
# Mobile (npm run build:mobile) : assets copiés → public/bible/s21 (~6 Mo dans l’APK)
#   Lecture + recherche sans /api/youversion ; sync CMS reste via PROD_ORIGIN/api/*
# Web preview : /api/youversion (Vercel ou vite.notion.ts en dev)
# Description sync: /api/description-sync?url=… (propriedade Notion Description du PLAN)
