# ——— Firebase Auth (client Vite + Android google-services.json) ———
# Console Firebase → Project settings → Your apps → Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# OAuth Web client ID (Google Sign-In navigateur) — même valeur que client Web Firebase
VITE_FIREBASE_WEB_CLIENT_ID=
# E-mail Google admin (id Notion stable clevencode) — optionnel
VITE_CLEVENCODE_ADMIN_EMAIL=
# Vercel serverless — JSON complet du compte de service Firebase (une ligne)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#
# Android APK:
# 1) Firebase Console → Add app → Android → package app.biblos.mobile
# 2) Télécharger google-services.json → android/app/google-services.json
# 3) SHA-1/256 du keystore debug (./gradlew signingReport) dans Firebase
# 4) npm run mobile:sync

NOTION_TOKEN=
# Data source IDs (collection://…) — BIBLECARDS + PLAN DE LECTURE BIBLIQUE
NOTION_BIBLECARDS_DB=903652b8-bfa0-4899-90fd-590837d6eb2f
NOTION_PLAN_DB=3d103af9-2e96-80c4-bcdd-000bd60ac72f
# Monitoring (3 DBs séparées) — créer via: npm run setup:user-dbs
# NOTION_PARENT_PAGE=<page_id>
NOTION_PROFILE_DB=
NOTION_ACTIVITY_DB=
NOTION_MESSAGES_DB=
# Compat legacy (fallback si PROFILE/MESSAGES vides)
# NOTION_ADMIN_DB=
# Notifications in-app (mises à jour) — DB sous la page Biblos
NOTION_NOTIFICATIONS_DB=5d217d65-b106-46f6-8ddc-c86ff7197e30
# Architecture (mobile-first):
# - Notion = CMS lecture seule via Vercel : /api/catalog, /api/notifications, /api/description-sync
# - Aucune donnée utilisateur vers Notion (profil, activité, flashcards, aide)
# - Firebase Auth + Firestore : profil, activité, messages d’aide
# - Notes du plan = localStorage uniquement
# Notifications: /api/notifications (annonces éditoriales Notion)
# Planos: Published (checkbox) obligatoire pour apparaître dans l’app
#   Audience = Admin | Shared (sans valeur = Shared)
#   Admin = visible seulement pour clevencode ; Shared = tous
# Index: /api/catalog?mode=index|full&scope=admin|shared
# Contenu = Notion seulement (jamais de seed StudyOS / ADS).
# VERSECARD Notion = admin clevencode seulement

# Deploy checklist:
# 1) npm run setup:user-dbs → copier les 3 IDs dans .env + Vercel
# 2) Notion → chaque DB → Connections → intégration
# 3) PLAN_DB → cocher Published + Audience=Admin sur les plans perso
# 4) Redeploy Vercel

# Texte biblique : Segond 21 locale (data/bible/s21) — node scripts/convert-s21.mjs
# Mobile (npm run build:mobile) : assets copiés → public/bible/s21 (~6 Mo dans l’APK)
#   Lecture + recherche sans /api/youversion ; sync Notion reste via PROD_ORIGIN/api/*
# Web preview : /api/youversion (Vercel ou vite.notion.ts en dev)
# Description sync: /api/description-sync?url=… (propriedade Notion Description do PLAN)
