rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Editor CMS: custom claim `admin: true` (Admin SDK / scripts/set-editor-claim.mjs).
    // Nunca confiar só em e-mail no cliente — anónimos têm request.auth.uid.
    function isEditor() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // CMS lecture (offline-first) — leitura pública só de planos publicados
    match /reading_plans/{planId} {
      allow read: if resource.data.isPublished == true || isEditor();
      allow create, update, delete: if isEditor();
    }

    // Données personnelles utilisateur (anonymous ou authenticated).
    // Jamais de textes bibliques ici — uniquement highlights / notes / planProgress.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
