{
  "name": "biblos",
  "private": true,
  "version": "0.2.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:mobile": "node scripts/stage-bible-assets.mjs && cross-env CAPACITOR=1 tsc && cross-env CAPACITOR=1 vite build",
    "mobile:sync": "npm run build:mobile && npx cap sync android",
    "mobile:open": "npx cap open android",
    "mobile:apk": "npm run mobile:sync && npm run mobile:gradle",
    "mobile:gradle": "powershell -ExecutionPolicy Bypass -File scripts/gradle-android.ps1 assembleDebug --no-daemon",
    "mobile:install": "powershell -ExecutionPolicy Bypass -File scripts/install-android.ps1",
    "mobile:live": "powershell -ExecutionPolicy Bypass -File scripts/install-android.ps1 -live",
    "preview": "vite preview",
    "bible:s21": "node scripts/convert-s21.mjs",
    "bible:study:export": "node scripts/export-study-compilado.mjs",
    "bible:study:strong": "node scripts/export-strong-lexicon.mjs",
    "bible:study:stage": "node scripts/stage-study-assets.mjs",
    "test:passage-viewstate": "npx --yes tsx scripts/test-passage-viewstate.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/status-bar": "^8.0.3",
    "@coolicons/react": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "capacitor-music-controls-plugin": "^8.0.0",
    "firebase": "^12.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "cross-env": "^10.1.0",
    "typescript": "~5.9.0",
    "vite": "^8.2.0"
  }
}
