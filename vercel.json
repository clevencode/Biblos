{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/youversion.mjs": {
      "includeFiles": "data/bible/s21/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet, noimageindex" }
      ]
    }
  ],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
